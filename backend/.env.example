# ===============================================
# JORIQUE BACKEND PRODUCTION ENVIRONMENT TEMPLATE
# ===============================================

# Server Environment & Port
NODE_ENV=production
PORT=5000

# Security & Authentication
JWT_SECRET=your-secure-random-jwt-secret-key
FRONTEND_URL=https://jorique.in,https://www.jorique.in

# Supabase Service Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google OAuth Client (Optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# SMTP Email Configuration (for OTP verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=care@jorique.in
SMTP_PASS=your-smtp-app-password
SMTP_FROM="JORIQUE Concierge" <care@jorique.in>
OTP_TTL_MINUTES=10
